diff --git a/Gems/Atom/RHI/Vulkan/Code/Include/Atom/RHI.Interface/Vulkan/RHIVulkanInterface.h b/Gems/Atom/RHI/Vulkan/Code/Include/Atom/RHI.Interface/Vulkan/RHIVulkanInterface.h
index 5d39c931d4..0376d97b09 100644
--- a/Gems/Atom/RHI/Vulkan/Code/Include/Atom/RHI.Interface/Vulkan/RHIVulkanInterface.h
+++ b/Gems/Atom/RHI/Vulkan/Code/Include/Atom/RHI.Interface/Vulkan/RHIVulkanInterface.h
@@ -15,6 +15,17 @@
 
 #include <vulkan/vulkan.h>
 
+// gz-rendering M4 zero-copy interop patch (not upstream).
+// The Vulkan RHI gem is compiled with -fvisibility=hidden, which keeps these
+// native-handle accessors LOCAL to the gem .so and unreachable from another
+// loaded module. Giving the declarations default visibility places them in the
+// .so's dynamic symbol table so the gz-rendering O3DE plugin (a separate module)
+// can resolve them at runtime, instead of linking the gem's static archive
+// (which would duplicate Vulkan-RHI state). See gz-rendering: o3de/patches/.
+#if defined(__GNUC__) || defined(__clang__)
+#  pragma GCC visibility push(default)
+#endif
+
 namespace AZ
 {
     namespace Vulkan
@@ -49,3 +60,7 @@ namespace AZ
         size_t GetImageAllocationOffset(RHI::DeviceImage& image);
     } // namespace Vulkan
 } // namespace AZ
+
+#if defined(__GNUC__) || defined(__clang__)
+#  pragma GCC visibility pop
+#endif
