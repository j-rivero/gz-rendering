<?xml version="1.0"?>
<!--
  gz-gui MinimalScene driven by the experimental O3DE/Atom render engine, shared
  with Qt over native Vulkan->Vulkan zero-copy (Atom renders on its own VkDevice,
  Qt imports the colour image onto its Vulkan-RHI device and samples it directly).

  Run it with o3de/examples/native_vulkan_live/live_demo.sh, which sets the
  required environment (the patched gz-gui, the Vulkan GUI backend, and the
  GZ_O3DE_INTEROP* toggles). The scene is empty here -- the box/sphere/cylinder
  come from GZ_O3DE_DEMO_SHAPES (set by the script), standing in for gz-sim.
-->
<window>
  <width>1024</width>
  <height>768</height>
</window>

<plugin filename="MinimalScene">
  <gz-gui>
    <title>O3DE / Atom -- native Vulkan zero-copy (live)</title>
    <property type="string" key="state">docked</property>
  </gz-gui>
  <engine>o3de</engine>
  <scene>scene</scene>
  <ambient_light>1 1 1</ambient_light>
  <background_color>0.8 0.8 0.8</background_color>
  <!-- Behind (-X) and slightly above (+Z) the shapes, pitched down just enough to
       centre them and fill the view. gz cameras look down +X; the demo shapes sit
       at x=0, y=+1.5/0/-1.5, z=0.5 (so they spread left-to-right across the view). -->
  <camera_pose>-4 0 1.2 0 0.12 0</camera_pose>
</plugin>

<!-- Mouse-driven orbit / pan / zoom on the MinimalScene viewport. The
     plugin calls camera->WorldPosition() / SetWorldPose() / HFOV() /
     AspectRatio() / ImageHeight() and scene->CreateRayQuery(); all
     are already implemented by O3deCamera / O3deScene, and GatherFrame
     in O3deRenderTarget.cc reads camera->WorldPose() every frame, so
     the new pose flows through to Atom automatically. No backend
     changes needed. -->
<plugin filename="InteractiveViewControl">
  <gz-gui>
    <property key="state" type="string">floating</property>
    <property key="x" type="double">0</property>
    <property key="y" type="double">0</property>
    <property key="width" type="double">5</property>
    <property key="height" type="double">5</property>
    <property key="showTitleBar" type="bool">false</property>
    <property key="resizable" type="bool">false</property>
  </gz-gui>
</plugin>

<!-- Stock gz-gui FPS overlay. CameraFps installs an event filter on the main
     window and times the interval between gui::events::Render events, which
     MinimalScene emits once per viewport render (MinimalScene.cc:392). That is
     exactly the rate at which our O3DE/Atom interop frame reaches the screen,
     so no backend plumbing is needed -- it is a pure gz-gui artifact. Note the
     viewport renders on demand, so the figure only updates while the view is
     being interacted with (or otherwise dirtied). -->
<plugin filename="CameraFps">
  <gz-gui>
    <property key="state" type="string">floating</property>
    <!-- Bottom-right of the default 1024x768 window (x = 1024-150-14,
         y = 768-40-38), leaving a small margin from the edges. -->
    <property key="x" type="double">860</property>
    <property key="y" type="double">690</property>
    <property key="width" type="double">150</property>
    <property key="height" type="double">40</property>
    <property key="showTitleBar" type="bool">false</property>
    <property key="resizable" type="bool">false</property>
  </gz-gui>
</plugin>
