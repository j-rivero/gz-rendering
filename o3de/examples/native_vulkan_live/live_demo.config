<?xml version="1.0"?>
<!--
  gz-gui MinimalScene driven by the experimental O3DE/Atom render engine, shared
  with Qt over native Vulkan->Vulkan zero-copy (Atom renders on its own VkDevice,
  Qt imports the colour image onto its Vulkan-RHI device and samples it directly).

  Run it with o3de/examples/native_vulkan_live/live_demo.sh, which sets the
  required environment (the patched gz-gui, the Vulkan GUI backend, and the
  GZ_O3DE_INTEROP* toggles). The scene is empty here -- the box/sphere/cylinder
  come from GZ_O3DE_DEMO_SHAPES (set by the script), standing in for gz-sim.
-->
<window>
  <width>1024</width>
  <height>768</height>
</window>

<plugin filename="MinimalScene">
  <gz-gui>
    <title>O3DE / Atom -- native Vulkan zero-copy (live)</title>
    <property type="string" key="state">docked</property>
  </gz-gui>
  <engine>o3de</engine>
  <scene>scene</scene>
  <ambient_light>1 1 1</ambient_light>
  <background_color>0.8 0.8 0.8</background_color>
  <!-- Behind (-X) and slightly above (+Z) the shapes, pitched down just enough to
       centre them and fill the view. gz cameras look down +X; the demo shapes sit
       at x=0, y=+1.5/0/-1.5, z=0.5 (so they spread left-to-right across the view). -->
  <camera_pose>-4 0 1.2 0 0.12 0</camera_pose>
</plugin>
